# 복사해서 사용:  copy .env.example .env
# ── Neo4j (기본값 = docker compose 로컬 인스턴스) ──
NEO4J_URI=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_PW=aeron-local-pw
NEO4J_DATABASE=neo4j
# Aura로 바꿀 때: NEO4J_URI=https://<인스턴스ID>.databases.neo4j.io, USER·DATABASE = 인스턴스 ID

# ── 웹 서버 ──
PORT=5173

# ── LLM (선택) — 비워 두면 지식그래프 기반 규칙 답변 ──
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
